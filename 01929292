local function onChar(p)
	task.wait(0.15)
	if p == LocalPlayer then return end
	if espOn then addESP(p) end
	if espNameOn then addName(p) end
end

for _, p in ipairs(Players:GetPlayers()) do
	p.CharacterAdded:Connect(function() onChar(p) end)
	if p.Character then onChar(p) end
end
Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function() onChar(p) end)
end)

local function getHead(p)
	return p.Character and p.Character:FindFirstChild("Head")
end
local function getHRP(p)
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end
local function getHum(p)
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end

local function closestInRange(maxR)
	local my = getHRP(LocalPlayer)
	if not my then return nil end
	local best, bestD = nil, maxR
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and getHum(p) and getHum(p).Health > 0 then
			local h = getHead(p)
			local hrp = getHRP(p)
			if h and hrp then
				local d = (hrp.Position - my.Position).Magnitude
				if d <= bestD then
					bestD = d
					best = h
				end
			end
		end
	end
	return best
end

RunService.RenderStepped:Connect(function()
	if aimOn and SelectedPlayer then
		local head = getHead(SelectedPlayer)
		local hum = getHum(SelectedPlayer)
		if head and hum and hum.Health > 0 then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
		end
	end
	if aimCommonOn then
		local head = closestInRange(commonRange)
		if head then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
		end
	end
	if speedOn then
		local hum = getHum(LocalPlayer)
		if hum then hum.WalkSpeed = speedVal end
	end
	if espNameOn then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then hideDefaultName(p) end
		end
	end
end)

