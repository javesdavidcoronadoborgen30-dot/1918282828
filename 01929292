	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local rel = math.clamp((input.Position.X - rangeBg.AbsolutePosition.X) / math.max(rangeBg.AbsoluteSize.X, 1), 0, 1)
		applyRange(5 + rel * 45)
	end
end)

