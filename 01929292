local function toggleAim()
	if not SelectedPlayer then
		notify("Elige un jugador")
		return
	end
	aimOn = not aimOn
	if aimOn then
		aimCommonOn = false
		if commonBtn then setBtn(commonBtn, false, "AIM COMUN: ON", "AIM COMUN: OFF") end
	end
	setBtn(aimBtn, aimOn, "Auto Aim: ON", "Auto Aim: OFF")
	if floatAim then floatAim.BackgroundColor3 = aimOn and OnCol or Btn end
end
aimBtn.MouseButton1Click:Connect(toggleAim)

local function makeDraggable(frame)
	local dragging, start, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			start = input.Position
			startPos = frame.Position
		end
	end)
	frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - start
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

local function createFloatAim()
	if floatAim then floatAim:Destroy() end
	local f = Instance.new("TextButton")
	f.Size = UDim2.new(0, 90, 0, 38)
	f.Position = UDim2.new(0, 20, 0.6, 0)
	f.BackgroundColor3 = aimOn and OnCol or Btn
	f.Text = "AIM"
	f.TextColor3 = TextC
	f.Font = Enum.Font.GothamBold
	f.TextSize = 14
	f.Parent = gui
	corner(f, 10)
	local fs = Instance.new("UIStroke")
	fs.Color = Accent2
	fs.Parent = f
	makeDraggable(f)
	f.MouseButton1Click:Connect(function()
		if not waitingKey then toggleAim() end
	end)
	floatAim = f
end

mBtn.MouseButton1Click:Connect(function()
	if floatAim then
		floatAim:Destroy()
		floatAim = nil
		notify("Flotante cerrado")
	else
		createFloatAim()
		notify("Arrastra AIM")
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if waitingKey and input.UserInputType == Enum.UserInputType.Keyboard then
		aimKey = input.KeyCode
		waitingKey = false
		if floatAim then floatAim.Text = "AIM" end
		notify("Tecla " .. aimKey.Name)
		return
	end
	if isMobile or gp then return end
	if input.KeyCode == aimKey then toggleAim() end
end)

