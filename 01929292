		espOn = espOn,
		espNameOn = espNameOn,
		aimKey = aimKey.Name,
	}
end

local function applySave(d)
	if not d then return end
	applySpeed(d.speedVal or 30)
	applyRange(d.commonRange or 15)
	aimOn = d.aimOn or false
	aimCommonOn = d.aimCommonOn or false
	speedOn = d.speedOn or false
	espOn = d.espOn or false
	espNameOn = d.espNameOn or false
	setBtn(aimBtn, aimOn, "Auto Aim: ON", "Auto Aim: OFF")
	setBtn(commonBtn, aimCommonOn, "AIM COMUN: ON", "AIM COMUN: OFF")
	setBtn(speedBtn, speedOn, "Speed: ON", "Speed: OFF")
	setBtn(espBtn, espOn, "ESP Rojo: ON", "ESP Rojo: OFF")
	setBtn(espNameBtn, espNameOn, "ESP Name: ON", "ESP Name: OFF")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if espOn then addESP(p) else remESP(p) end
			if espNameOn then addName(p) else remName(p) restoreDefaultName(p) end
		end
	end
end

