local function hideDefaultName(p)
	if not p.Character then return end
	local hum = p.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.NameDisplayDistance = 0
		hum.HealthDisplayDistance = 0
	end
end

local function restoreDefaultName(p)
	if not p.Character then return end
	local hum = p.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		hum.NameDisplayDistance = 100
	end
end

local function addESP(p)
	if not p.Character then return end
	local hl = p.Character:FindFirstChild("AS_ESP")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "AS_ESP"
		hl.FillTransparency = 0.45
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = p.Character
	end
	hl.FillColor = RedESP
	hl.OutlineColor = RedESP
end

local function remESP(p)
	if p.Character then
		local h = p.Character:FindFirstChild("AS_ESP")
		if h then h:Destroy() end
	end
end

local function addName(p)
	if not p.Character or p == LocalPlayer then return end
	hideDefaultName(p)
	local head = p.Character:FindFirstChild("Head")
	if not head or head:FindFirstChild("AS_Name") then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "AS_Name"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.new(0, 150, 0, 22)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.Parent = head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Text = p.DisplayName
	l.TextColor3 = RedESP
	l.TextStrokeTransparency = 0.35
	l.Font = Enum.Font.GothamBold
	l.TextSize = 13
	l.Parent = bb
end

local function remName(p)
	if p.Character then
		local head = p.Character:FindFirstChild("Head")
		if head then
			local n = head:FindFirstChild("AS_Name")
			if n then n:Destroy() end
		end
		if not espNameOn then restoreDefaultName(p) end
	end
end

