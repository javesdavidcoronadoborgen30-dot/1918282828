			btn.TextSize = 12
			btn.Parent = playerList
			corner(btn, 6)
			btn.MouseButton1Click:Connect(function()
				SelectedPlayer = (SelectedPlayer == p) and nil or p
				refreshList()
				listLabel.Text = SelectedPlayer and ("Target: " .. SelectedPlayer.DisplayName) or "Target: nadie"
				listLabel.TextColor3 = SelectedPlayer and Accent or Dim
			end)
			listButtons[p] = btn
		end
	end
	playerList.CanvasSize = UDim2.new(0, 0, 0, n * 26)
end
